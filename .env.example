# ─────────────────────────────────────────────────────────────
#  그려봄 설정 파일
# ─────────────────────────────────────────────────────────────
#  1) 이 파일을 .env 로 복사해요:   cp .env.example .env
#  2) 아래 값을 채워요. ‘예)’ 는 모양만 보여 주는 예시라 그대로 쓰지 말고 우리 기관 값으로 바꿔 주세요.
#  3) 바꾼 뒤에는 다시 시작해요:   docker compose up -d
#
#  ⚠ .env 에는 관리자 비밀번호 · 로그인 비밀값이 들어가요. 깃허브 등 어디에도 올리지 마세요.
#  맨 아래 ‘채운 예시’ 를 보면 한눈에 감을 잡을 수 있어요.


# ── 1. 주소 ──────────────────────────────────────────────────

# 공유 링크(/s/…)와 모임 초대 링크에 쓸 대표 주소. 끝에 / 는 빼고 적어요.
# 비워 두면 사용자가 접속한 주소를 그대로 써요.
# 예) PUBLIC_URL=https://myline.example.kr
PUBLIC_URL=

# 이 서버에서 열 포트.
#   - 이 컴퓨터가 바로 인터넷에 열려 있으면 80
#   - 리버스 프록시(nginx · Caddy · NAS 의 역방향 프록시 등) 뒤에 두면 8080 등 다른 번호 (그 프록시가 이 포트로 넘겨줘요)
# 예) PORT=8080
PORT=80


# ── 2. 관리자 화면 (/admin) ──────────────────────────────────

# 둘 다 채워야 관리자 화면이 열려요. 하나라도 비우면 관리자 기능은 꺼져 있어요.
# 비밀번호는 12자 이상, 다른 곳에서 쓰지 않는 것으로 정해 주세요.
# 예) ADMIN_ID=operator
# 예) ADMIN_PASSWORD=bright-river-2031-maple
ADMIN_ID=
ADMIN_PASSWORD=


# ── 3. 보안 ──────────────────────────────────────────────────

# 로그인 쿠키를 HTTPS 에서만 보낼지. 실제 운영은 꼭 true.
# 내 컴퓨터에서 http:// 로 시험할 때만 false 로 바꿔요.
COOKIE_SECURE=true

# 로그인 비밀값 (이름 + 생년월일로 로그인 키를 만들 때 쓰는 값). 32자 이상 무작위로.
#   만들기:  openssl rand -hex 32
#   ⚠ 한 번 정하면 절대 바꾸지 마세요. 바꾸면 모든 사람이 로그인할 수 없어요.
#   ⚠ 비워 두면 서버가 알아서 만들어 DB 안에 넣어요. 이 경우 DB 백업 파일 하나만 새어도
#     흔한 이름 · 생일을 대입해 회원 정보를 알아낼 수 있으니, 운영할 때는 꼭 채워 주세요.
# 예) AUTH_SECRET=3f9c1e…(64자리 16진수)
AUTH_SECRET=

# 앞단 프록시 뒤에서 ‘진짜 접속 IP’ 를 남기기.
#   리버스 프록시 · 로드밸런서 · Cloudflare 같은 것을 거쳐 들어오면, 관리자 접속 기록과 로그인 시도 제한에
#   그 프록시의 주소(도커 내부 172.x.x.x 등)만 남아요. 그 프록시의 주소 대역을 적으면 원래 접속 IP 를 써요.
#   - 같은 서버의 도커 바깥에서 리버스 프록시가 넘겨준다면 보통:  172.16.0.0/12
#   - 여러 개는 띄어 써요:  172.16.0.0/12 10.0.0.0/8
#   ⚠ PORT 가 프록시를 거치지 않고 인터넷에 바로 열려 있으면 누구나 IP 를 꾸며 보낼 수 있으니, 그때는 비워 두세요.
#   ※ 집 · 사무실 안에서 DDNS 주소로 들어가면 공유기 주소(예: 192.168.0.1)가 찍혀요. 바깥(휴대폰 데이터)에서는 진짜 IP 가 찍혀요.
# 예) TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_PROXIES=


# ── 4. 이용약관 · 개인정보 처리방침에 들어갈 운영 정보 ─────────
#  서비스를 열기 전에 꼭 채워 주세요. 비우면 문서에 ‘정해질 예정’ 으로 보여요.
#  관리자 화면 → 사이트 설정에서도 바꿀 수 있어요 (거기서 저장하면 그 값을 먼저 써요).

# 이용약관 · 처리방침의 ‘운영자’ 로 보일 기관 이름 (최대 60자)
# 예) SERVICE_OPERATOR=○○시 청소년수련관
SERVICE_OPERATOR=

# 개인정보 처리방침 ‘11. 문의처’ 에 보일 이메일 (이메일 주소만)
# 예) PRIVACY_CONTACT=privacy@example.kr
PRIVACY_CONTACT=


# ── 5. 만든 사람 (사이트 아래 ‘만든 사람’ 탭 · /credits?tab=team) ──
#  여기 적은 값은 누구나 보는 화면에 그대로 나와요. 공개해도 되는 것만 적어 주세요.
#  모두 비워도 돼요. 비운 항목은 그 줄이 화면에서 빠져요.
#  (그려봄을 처음 만든 개발자 줄은 코드에 들어 있어서 이 설정과 관계없이 항상 보여요)
#
#   화면 모양:   MADE BY
#               ○○ 운영팀              ← DEV_NAME
#               ○○시 청소년수련관        ← DEV_ORG
#               개발   (코드에 들어 있는 개발자)
#               연락   hello@example.kr  ← DEV_CONTACT
#               저장소  github.com/…      ← DEV_URL

# 카드 맨 위에 크게 보이는 이름 (최대 40자). 비우면 ‘그려봄 만든 사람들’
# 예) DEV_NAME=○○ 운영팀
DEV_NAME=

# 이름 아래 작은 글씨로 보이는 소속 기관 · 팀 (최대 60자)
# 예) DEV_ORG=○○시 청소년수련관
DEV_ORG=

# ‘연락’ 줄. 이메일(누르면 메일 쓰기) 또는 https:// 주소(누르면 새 탭) 중 하나
# 예) DEV_CONTACT=hello@example.kr
# 예) DEV_CONTACT=https://forms.example.kr/contact
DEV_CONTACT=

# ‘저장소’ 줄. 이 서비스의 소스 코드 주소 (https:// 로 시작)
#   그려봄은 AGPL-3.0 이라, 고쳐서 서비스할 때는 이용자가 그 소스를 볼 수 있게 이 값을 채워 주세요.
# 예) DEV_URL=https://github.com/example-org/geuryeobom
DEV_URL=


# ── 6. 자동 백업 ─────────────────────────────────────────────

# 서버가 한 시간에 하나씩 DB 를 이 폴더(docker-compose.yml 옆)의 backups/auto-날짜-시.db 로 남겨요.
#   최근 몇 개를 둘지 (기본 168 = 7일, 0 이면 끔). 같은 디스크 안이라 디스크 고장에는 대비가 안 돼요.
#   가끔은 backups 폴더나 관리자 화면 → 서버 상태에서 내려받아 다른 곳에도 두세요.
# 예) BACKUP_KEEP=336   (14일)
BACKUP_KEEP=168


# ─────────────────────────────────────────────────────────────
#  채운 예시 (같은 서버의 리버스 프록시 뒤에서 HTTPS 로 운영하는 경우)
#  아래는 모양만 보여 주는 가짜 값이에요. 그대로 복사하지 말고 우리 기관 값으로 바꿔 주세요.
# ─────────────────────────────────────────────────────────────
# PUBLIC_URL=https://myline.example.kr
# PORT=8080
# ADMIN_ID=operator
# ADMIN_PASSWORD=bright-river-2031-maple
# COOKIE_SECURE=true
# AUTH_SECRET=(openssl rand -hex 32 로 만든 64자리 값)
# TRUSTED_PROXIES=172.16.0.0/12
# SERVICE_OPERATOR=○○시 청소년수련관
# PRIVACY_CONTACT=privacy@example.kr
# DEV_NAME=○○ 운영팀
# DEV_ORG=○○시 청소년수련관
# DEV_CONTACT=hello@example.kr
# DEV_URL=https://github.com/example-org/geuryeobom
# BACKUP_KEEP=168
