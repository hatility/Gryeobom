{
  "name": "geuryeobom",
  "private": true,
  "version": "1.1.0",
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "DB_FILE=./data/dev.db COOKIE_SECURE=false DEV_SERVER=true PORT=3001 node --watch server/index.ts",
    "build": "tsc --noEmit && tsc --noEmit -p server && vite build && node scripts/licenses.mjs && vite build --ssr server/index.ts --outDir dist-server",
    "preview": "vite preview",
    "test": "vitest run",
    "release": "npm run build && node scripts/release.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "qrcode-generator": "1.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.0.5"
  }
}
